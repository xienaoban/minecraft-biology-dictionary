#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
*           text=auto   eol=lf

# These are Windows script files and should use crlf
*.cmd       text        eol=crlf
*.bat       text        eol=crlf
*.ps1       text        eol=crlf

*.png       binary
*.jpg       binary
*.exe       binary
*.dll       binary
*.jar       binary
*.lnk       binary
*.aseprite  binary
