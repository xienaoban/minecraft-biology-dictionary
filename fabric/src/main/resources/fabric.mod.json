{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "A biology dictionary for Minecraft.",
	"authors": [
		"XieNaoban"
	],
	"license": "${mod_license}",
	"icon": "assets/biologydictionary/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.xienaoban.biologydictionary.FabricBiologyDictionary"
		],
		"client": [
			"io.github.xienaoban.biologydictionary.FabricBiologyDictionaryClient"
		]
	},
	"mixins": [
		"biologydictionary.mixins.json",
		"biologydictionary-fabric.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
