{
    "schemaVersion": 1,
    "id": "biologydictionary",
    "version": "${version}",
    "name": "Biology Dictionary",
    "description": "To display or modify the properties and states of mobs.",
    "authors": [
        "XieNaoban"
    ],
    "contact": {
        "homepage": "https://github.com/xienaoban/minecraft-biology-dictionary",
        "sources": "https://github.com/xienaoban/minecraft-biology-dictionary",
        "repo": "https://github.com/xienaoban/minecraft-biology-dictionary",
        "issues": "https://github.com/xienaoban/minecraft-biology-dictionary/issues"
    },
    "license": "LGPL-3.0",
    "icon": "assets/biologydictionary/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.github.xienaoban.biologydictionary.fabric.BiologyDictionaryFabric"
        ],
        "client": [
            "io.github.xienaoban.biologydictionary.fabric.BiologyDictionaryFabricClient"
        ],
        "modmenu": [
            "io.github.xienaoban.biologydictionary.config.fabric.ModMenuConfigScreenProvider"
        ]
    },
    "accessWidener" : "biologydictionary.accesswidener",
    "mixins": [
        "biologydictionary.mixins.json",
        "biologydictionary-fabric.mixins.json"
    ],
    "depends": {
        "minecraft": "${minecraft_version}",
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "cloth-config": ">=${clothconfig_version}",
        "java": ">=17"
    },
    "suggests": {
        "modmenu": ">=${modmenu_version}"
    }
}
