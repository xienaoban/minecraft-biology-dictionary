{
  "schemaVersion": 1,
  "id": "biologydictionary",
  "version": "${version}",
  "name": "Biology Dictionary",
  "description": "A mod to display or modify the properties and states of entities.",
  "authors": [
    "xienaoban"
  ],
  "contact": {
    "website": "https://xienaoban.github.io",
    "repo": "https://github.com/xienaoban/minecraft-biology-dictionary"
  },
  "license": "LGPL-3.0",
  "icon": "assets/biologydictionary/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "io.github.xienaoban.minecraft.biologydictionary.common.ClientModInitializer"
    ],
    "main": [
      "io.github.xienaoban.minecraft.biologydictionary.common.ModInitializer"
    ]
  },
  "mixins": [
    "biologydictionary.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "java": ">=21"
  }
}
