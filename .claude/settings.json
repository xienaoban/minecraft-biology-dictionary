{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(./gradlew fabric:build *)",
      "Bash(./gradlew neoforge:build *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git tag -l *)",
      "Bash(git rev-parse *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(findstr *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git revert *)",
      "Bash(git cherry-pick *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag --delete *)",
      "Bash(git tag -d *)",
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(rmdir *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(jar *)",
      "Bash(unzip *)"
    ],
    "additionalDirectories": [
      "../mc-source"
    ],
    "sandbox": {
      "filesystem": {
        "denyWrite": [
          "../mc-source"
        ]
      }
    }
  }
}
